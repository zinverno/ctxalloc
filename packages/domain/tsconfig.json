{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // The canonical block content hash uses the Node standard library, so this
    // package needs the Node ambient types. It uses no other global environment.
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"]
}
