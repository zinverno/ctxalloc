{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@ctxalloc/application": ["packages/application/src/index.ts"],
      "@ctxalloc/adapters": ["packages/adapters/src/index.ts"],
      "@ctxalloc/compiler": ["packages/compiler/src/index.ts"],
      "@ctxalloc/domain": ["packages/domain/src/index.ts"],
      "@ctxalloc/evaluation": ["packages/evaluation/src/index.ts"],
      "@ctxalloc/ports": ["packages/ports/src/index.ts"],
      "@ctxalloc/testing": ["packages/testing/src/index.ts"],
      "@ctxalloc/tokenization": ["packages/tokenization/src/index.ts"],
      // The retrieval library is a dependency of `@ctxalloc/adapters`, so a test
      // that imports it directly needs its types resolved explicitly.
      "minisearch": ["packages/adapters/node_modules/minisearch/dist/es/index.d.ts"]
    }
  },
  "include": ["**/*.ts"]
}
