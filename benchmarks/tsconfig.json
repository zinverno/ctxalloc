{
  // Type-check program for the benchmark dataset.
  //
  // The dataset is TypeScript rather than JSON because every case derives its
  // content hashes and token counts (DEC-040), so it needs the same strict
  // settings and the same workspace resolution the tests use. It emits nothing.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@ctxalloc/compiler": ["packages/compiler/src/index.ts"],
      "@ctxalloc/domain": ["packages/domain/src/index.ts"],
      "@ctxalloc/evaluation": ["packages/evaluation/src/index.ts"],
      "@ctxalloc/ports": ["packages/ports/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
